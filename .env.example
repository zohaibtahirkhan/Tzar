# ============================================================
# Tzar — configuration
# Copy to .env and edit. Every setting is optional; defaults live in
# app/config.py. Names are case-insensitive.
# ============================================================

# ─── LLM ────────────────────────────────────────────────────
# "ollama" (default, recommended) or "llamacpp"
LLM_BACKEND=ollama
# Must match a model from `ollama list` (e.g. qwen2.5:3b on 8 GB RAM)
LLM_MODEL=qwen2.5:7b
LLM_OLLAMA_HOST=http://localhost:11434
LLM_CONTEXT_LENGTH=8192
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7

# llama.cpp backend only: GGUF file, CPU threads, GPU layers (-1 = all)
LLM_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
LLM_THREADS=6
LLM_N_GPU_LAYERS=0

# ─── STT ────────────────────────────────────────────────────
# Whisper size: tiny, base, small, medium, large-v3
# small = best balance of speed + Urdu/English accuracy on CPU
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Blank = auto-detect; e.g. "ur" forces Urdu
STT_LANGUAGE=

# ─── VAD ────────────────────────────────────────────────────
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=700

# ─── Wake Word ──────────────────────────────────────────────
# Built-in openWakeWord models: hey_jarvis, alexa, hey_mycroft
# (or a path to a custom .onnx model you trained)
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
# Only the text shown in prompts — it does not change what is detected
WAKE_WORD_PHRASE=Hey Jarvis

# ─── TTS ────────────────────────────────────────────────────
# Kokoro voice IDs: af_heart, af_bella, am_adam, bf_emma
TTS_VOICE=af_heart
TTS_SPEED=1.0

# ─── Audio I/O ──────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_MS=32
# Blank = system default device
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# ─── Memory ─────────────────────────────────────────────────
MEMORY_SHORT_TERM_LIMIT=20
MEMORY_LONG_TERM_ENABLED=true

# ─── Web Search ─────────────────────────────────────────────
# Off by default — say "enable web search" to turn it on for a session
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_RESULTS=5

# ─── Obsidian ───────────────────────────────────────────────
# Your vault ("~" is expanded). Created if it doesn't exist.
OBSIDIAN_VAULT_PATH=~/Documents/notes
# Re-index notes you edit in Obsidian itself, not only through the assistant
OBSIDIAN_WATCH_ENABLED=true
OBSIDIAN_WATCH_DEBOUNCE_S=3.0
OBSIDIAN_BACKFILL_ON_START=true

# ─── Local documents ────────────────────────────────────────
# Default folder for ingest_directory
# RAG_DOCUMENTS_DIR=~/Documents

# ─── MCP Servers ────────────────────────────────────────────
MCP_ENABLED=false
# JSON array: {"name", "transport": "http"|"stdio", "url" or "command", "env"?}
MCP_SERVERS='[]'

# ─── Coordinator (multi-step tasks) ─────────────────────────
MULTI_AGENT_ENABLED=false
GOAL_TRACKING_ENABLED=true
CRITIC_ENABLED=true

# ─── API Server ─────────────────────────────────────────────
# Keep on 127.0.0.1: the API has no authentication
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=info
# Extra browser origins allowed to call the API (comma-separated).
# The desktop app and the Vite dev server are always allowed.
ALLOWED_ORIGINS=
