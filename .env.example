# ============================================================
# Local Voice Assistant — Environment Configuration
# Copy this file to .env and customise as needed.
# ============================================================

# ─── LLM ────────────────────────────────────────────────────
# Path to your .gguf model file
LLM_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
# Number of CPU threads for inference (leave 2 for OS/audio)
LLM_THREADS=6
LLM_CONTEXT_LENGTH=4096
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7

# ─── STT ────────────────────────────────────────────────────
# Whisper model size: tiny, base, small, medium
# small = best balance of speed + Urdu/English accuracy on CPU
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Leave blank for auto-detect (supports Urdu + English)
STT_LANGUAGE=

# ─── VAD ────────────────────────────────────────────────────
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=700

# ─── Wake Word ──────────────────────────────────────────────
# Built-in OpenWakeWord models: hey_jarvis, alexa, hey_mycroft
# For a custom "Hey Zohaib" model, train one via openWakeWord and
# set the path here.
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
WAKE_WORD_PHRASE=Hey Zohaib

# ─── TTS ────────────────────────────────────────────────────
# Kokoro voice IDs: af_heart, af_bella, am_adam, bf_emma
TTS_VOICE=af_heart
TTS_SPEED=1.0

# ─── Audio I/O ──────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_MS=32
# Leave blank to use system default device
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# ─── Memory ─────────────────────────────────────────────────
MEMORY_SHORT_TERM_LIMIT=20
MEMORY_LONG_TERM_ENABLED=true

# ─── Web Search ─────────────────────────────────────────────
# DISABLED by default — user must explicitly request online search
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_RESULTS=5

# ─── API Server ─────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=info

# ─── Obsidian ─────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=/home/zohaib/Documents/notes


# ─── MCP Servers ─────────────────────────────────────────────
MCP_SERVERS='[]'


# ─── Multi Agent Orchestrator ─────────────────────────────────────────────
MULTI_AGENT_ENABLED=true          # enables Coordinator for complex tasks
MULTI_AGENT_EXPERIMENTAL=false    # keep old 5-agent orchestrator off
GOAL_TRACKING_ENABLED=true
CRITIC_ENABLED=true


# ─── CORS Configuration (Production) ─────────────────────────────────────────
# Additional origins for CORS (comma-separated)
# Example: ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com
# Default allows localhost only (secure for local-only deployment)
ALLOWED_ORIGINS=
